        "minecraft:container": [
            {
                item: {
                    components: {
                        "minecraft:enchantment_glint_override": 1b,
                        "minecraft:item_name": {text: "Console Administrativa", color: "aqua", bold: 1b, italic: 0b},
                        "minecraft:lore": [
                            {text: "Gamemode, horario, efeitos e adocao dos pets", color: "gray", italic: 0b},
                            {text: "Os botoes exigem cheats/permissao de comandos", color: "yellow", italic: 0b}
                        ],
                        "minecraft:rarity": "epic",
                        "minecraft:written_book_content": {
                            author: "Celestine",
                            generation: 0,
                            pages: [
                                {
                                    raw: {
                                        text: "",
                                        extra: [
                                            {text: "GAMEMODE\n\n", color: "dark_purple", bold: 1b},
                                            {text: "[ Survival ]\n", color: "green", bold: 1b, click_event: {action: "run_command", command: "/gamemode survival @s"}},
                                            {text: "[ Creative ]\n", color: "aqua", bold: 1b, click_event: {action: "run_command", command: "/gamemode creative @s"}},
                                            {text: "[ Adventure ]\n", color: "gold", bold: 1b, click_event: {action: "run_command", command: "/gamemode adventure @s"}},
                                            {text: "[ Spectator ]", color: "gray", bold: 1b, click_event: {action: "run_command", command: "/gamemode spectator @s"}}
                                        ]
                                    }
                                },
                                {
                                    raw: {
                                        text: "",
                                        extra: [
                                            {text: "HORARIO\n\n", color: "dark_blue", bold: 1b},
                                            {text: "[ Dia ]\n", color: "yellow", bold: 1b, click_event: {action: "run_command", command: "/time set day"}},
                                            {text: "[ Meio-dia ]\n", color: "gold", bold: 1b, click_event: {action: "run_command", command: "/time set noon"}},
                                            {text: "[ Noite ]\n", color: "blue", bold: 1b, click_event: {action: "run_command", command: "/time set night"}},
                                            {text: "[ Meia-noite ]", color: "dark_purple", bold: 1b, click_event: {action: "run_command", command: "/time set midnight"}}
                                        ]
                                    }
                                },
                                {
                                    raw: {
                                        text: "",
                                        extra: [
                                            {text: "EFEITOS - PODER\n\n", color: "red", bold: 1b},
                                            {text: "[ Visao Noturna ]\n", color: "aqua", click_event: {action: "run_command", command: "/effect give @s minecraft:night_vision infinite 0 true"}},
                                            {text: "[ Velocidade III ]\n", color: "blue", click_event: {action: "run_command", command: "/effect give @s minecraft:speed infinite 2 true"}},
                                            {text: "[ Pressa IV ]\n", color: "yellow", click_event: {action: "run_command", command: "/effect give @s minecraft:haste infinite 3 true"}},
                                            {text: "[ Forca III ]\n", color: "dark_red", click_event: {action: "run_command", command: "/effect give @s minecraft:strength infinite 2 true"}},
                                            {text: "[ Limpar efeitos ]", color: "gray", click_event: {action: "run_command", command: "/effect clear @s"}}
                                        ]
                                    }
                                },
                                {
                                    raw: {
                                        text: "",
                                        extra: [
                                            {text: "EFEITOS - DEFESA\n\n", color: "dark_green", bold: 1b},
                                            {text: "[ Resistencia II ]\n", color: "green", click_event: {action: "run_command", command: "/effect give @s minecraft:resistance infinite 1 true"}},
                                            {text: "[ Resistencia ao Fogo ]\n", color: "gold", click_event: {action: "run_command", command: "/effect give @s minecraft:fire_resistance infinite 0 true"}},
                                            {text: "[ Respiracao Aquatica ]\n", color: "aqua", click_event: {action: "run_command", command: "/effect give @s minecraft:water_breathing infinite 0 true"}},
                                            {text: "[ Regeneracao II ]\n", color: "light_purple", click_event: {action: "run_command", command: "/effect give @s minecraft:regeneration infinite 1 true"}},
                                            {text: "[ Queda Lenta ]", color: "white", click_event: {action: "run_command", command: "/effect give @s minecraft:slow_falling infinite 0 true"}}
                                        ]
                                    }
                                },
                                {
                                    raw: {
                                        text: "",
                                        extra: [
                                            {text: "ADOTAR PETS\n", color: "light_purple", bold: 1b},
                                            {text: "Use perto do pet (ate 16 blocos).\n\n", color: "gray"},
                                            {text: "[ Adotar Nicks ]\n", color: "gold", bold: 1b, click_event: {action: "run_command", command: "/data modify entity @e[type=minecraft:cat,name=Nicks,distance=..16,sort=nearest,limit=1] Owner set from entity @s UUID"}},
                                            {text: "[ Adotar Kuronai ]\n", color: "dark_purple", bold: 1b, click_event: {action: "run_command", command: "/data modify entity @e[type=minecraft:wolf,name=Kuronai,distance=..16,sort=nearest,limit=1] Owner set from entity @s UUID"}},
                                            {text: "[ Adotar Celestine ]", color: "aqua", bold: 1b, click_event: {action: "run_command", command: "/data modify entity @e[type=minecraft:wolf,name=Celestine,distance=..16,sort=nearest,limit=1] Owner set from entity @s UUID"}}
                                        ]
                                    }
                                }
                            ],
